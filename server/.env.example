# --- Required ---
DATABASE_URL=postgresql://smartfarm:smartfarm@localhost:5432/smartfarm
# Long random string (e.g. `openssl rand -hex 32`). Required in production.
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=4000
# Browser origin of the web app (used in password-reset links)
WEB_ORIGIN=http://localhost:5173
# Public base URL of the API as reachable by ESP32 robots (shown on the Robot page). Optional.
PUBLIC_API_URL=

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Robot ---
# Minutes since last contact before a robot is shown as disconnected
ROBOT_ONLINE_MINUTES=10
# Window (days) used for "zones surveyed" progress and stale-data warnings
SURVEY_WINDOW_DAYS=30

# --- Email (password reset). Without SMTP, dev mode prints the reset link to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Farm <no-reply@example.com>

# --- AI providers (server-side only; keys are never sent to the browser) ---
# AI_DISEASE_PROVIDER: none | kindwise | anthropic | custom
# AI_NUTRIENT_PROVIDER: none | anthropic | custom
AI_DISEASE_PROVIDER=none
AI_NUTRIENT_PROVIDER=none
KINDWISE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Self-hosted model endpoint (see README "Custom AI model")
CUSTOM_AI_URL=
CUSTOM_AI_TOKEN=
